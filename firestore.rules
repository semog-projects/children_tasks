rules_version = '2';

// Modelo de dados: docs/data-model.md (issue #6).
//
// Premissa: só o responsável autentica. Crianças são perfis locais na sessão
// do responsável (issue #8). Portanto as regras distinguem apenas
// "é responsável desta família" vs. "não é". As restrições do modo criança
// são aplicadas no cliente.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function familyData(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function isGuardian(familyId) {
      return isSignedIn()
        && request.auth.uid in familyData(familyId).guardianUids;
    }

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function optionalString(data, field, maxLen) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxLen);
    }

    // ---- users --------------------------------------------------------
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- families ----------------------------------------------------
    match /families/{familyId} {
      allow get: if isGuardian(familyId);
      // Só devolve famílias em que o solicitante já é responsável
      // (a query precisa filtrar por guardianUids arrayContains uid).
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.guardianUids;

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.guardianUids
        && request.resource.data.guardianUids.size() >= 1
        && request.resource.data.guardians is list
        && isNonEmptyString(request.resource.data.name, 60)
        && request.resource.data.timezone is string;

      allow update: if isGuardian(familyId)
        && request.auth.uid in request.resource.data.guardianUids
        && request.resource.data.guardianUids.size() >= 1
        && request.resource.data.guardians is list
        && isNonEmptyString(request.resource.data.name, 60);

      allow delete: if false;

      match /members/{memberId} {
        allow read: if isGuardian(familyId);
        allow create, update: if isGuardian(familyId)
          && request.resource.data.type in ['guardian', 'child']
          && isNonEmptyString(request.resource.data.displayName, 60);
        allow delete: if isGuardian(familyId);
      }

      match /tasks/{taskId} {
        allow read: if isGuardian(familyId);
        allow create, update: if isGuardian(familyId)
          && isNonEmptyString(request.resource.data.title, 80)
          && request.resource.data.points is int
          && request.resource.data.points > 0
          && request.resource.data.category in
             ['routine', 'study', 'chores', 'hygiene', 'other']
          && request.resource.data.requiresApproval is bool
          && request.resource.data.active is bool
          && optionalString(request.resource.data, 'description', 500);
        allow delete: if isGuardian(familyId);
      }

      match /taskInstances/{instanceId} {
        allow read: if isGuardian(familyId);
        allow create, update: if isGuardian(familyId)
          && request.resource.data.status in
             ['pending', 'awaitingApproval', 'approved', 'rejected']
          && request.resource.data.taskId is string
          && request.resource.data.memberId is string;
        allow delete: if isGuardian(familyId);
      }

      match /rewards/{rewardId} {
        allow read: if isGuardian(familyId);
        allow create, update: if isGuardian(familyId)
          && isNonEmptyString(request.resource.data.title, 80)
          && request.resource.data.cost is int
          && request.resource.data.cost > 0
          && request.resource.data.active is bool
          && optionalString(request.resource.data, 'description', 500);
        allow delete: if isGuardian(familyId);
      }

      // Append-only: sem update/delete pelo cliente.
      match /ledger/{entryId} {
        allow read: if isGuardian(familyId);
        allow create: if isGuardian(familyId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.memberId is string
          && request.resource.data.type in ['earn', 'redeem', 'adjustment']
          && request.resource.data.points is int
          && request.resource.data.points != 0
          && request.resource.data.sourceType in ['taskInstance', 'reward', 'manual'];
        allow update, delete: if false;
      }
    }

    // Qualquer outro caminho: negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
