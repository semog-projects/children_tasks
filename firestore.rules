rules_version = '2';

// Modelo de dados: docs/data-model.md (issues #6, #33, #34).
//
// Dois papéis por família:
//  - responsável: `uid in family.guardianUids` — acesso total.
//  - criança: `uid in family.childUids` (login próprio, issue #33) — leitura
//    da família/tarefas/recompensas, e das PRÓPRIAS `taskInstances`/`ledger`/
//    `redemptions` (via `memberUid == uid`, denormalizado pelas Functions).
//    A criança só marca a própria tarefa (`pending -> awaitingApproval`, ou
//    `-> approved` quando não exige aprovação) — a trava de auto-aprovação
//    é do servidor. `earn`/`redeem` no ledger e o crédito (`pointsAwarded`)
//    seguem exclusivos das Functions.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function familyData(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function isGuardian(familyId) {
      return isSignedIn()
        && request.auth.uid in familyData(familyId).guardianUids;
    }

    function isChildOf(familyId) {
      return isSignedIn()
        && request.auth.uid in familyData(familyId).childUids;
    }

    // Doc (taskInstance / ledger / redemption) da própria criança logada.
    function ownsChildDoc(data) {
      return isSignedIn() && data.get('memberUid', null) == request.auth.uid;
    }

    function isNonEmptyString(v, maxLen) {
      return v is string && v.size() > 0 && v.size() <= maxLen;
    }

    function optionalString(data, field, maxLen) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxLen);
    }

    // ---- users --------------------------------------------------------
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      // Tokens FCM do próprio dispositivo (issue #14).
      match /fcmTokens/{token} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ---- familyInvites ----------------------------------------------
    // Convites de vínculo (criança / responsável) — issue #33. Só as Cloud
    // Functions (admin) leem/escrevem; o cliente age pelas callables
    // `createFamilyInvite` / `acceptFamilyInvite`.
    match /familyInvites/{code} {
      allow read, write: if false;
    }

    // ---- families ----------------------------------------------------
    match /families/{familyId} {
      allow get: if isGuardian(familyId) || isChildOf(familyId);
      // Só devolve famílias do solicitante (a query filtra por
      // guardianUids/childUids arrayContains uid).
      allow list: if isSignedIn()
        && (request.auth.uid in resource.data.guardianUids
            || request.auth.uid in resource.data.childUids);

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.guardianUids
        && request.resource.data.guardianUids.size() >= 1
        && request.resource.data.guardians is list
        && isNonEmptyString(request.resource.data.name, 60)
        && request.resource.data.timezone is string;

      allow update: if isGuardian(familyId)
        && request.auth.uid in request.resource.data.guardianUids
        && request.resource.data.guardianUids.size() >= 1
        && request.resource.data.guardians is list
        && isNonEmptyString(request.resource.data.name, 60);

      allow delete: if false;

      match /members/{memberId} {
        allow read: if isGuardian(familyId) || isChildOf(familyId);
        allow create, update: if isGuardian(familyId)
          && request.resource.data.type in ['guardian', 'child']
          && isNonEmptyString(request.resource.data.displayName, 60);
        allow delete: if isGuardian(familyId);
      }

      match /tasks/{taskId} {
        allow read: if isGuardian(familyId) || isChildOf(familyId);
        allow create, update: if isGuardian(familyId)
          && isNonEmptyString(request.resource.data.title, 80)
          && request.resource.data.points is int
          && request.resource.data.points > 0
          && request.resource.data.category in
             ['routine', 'study', 'chores', 'hygiene', 'other']
          && request.resource.data.requiresApproval is bool
          && request.resource.data.active is bool
          && optionalString(request.resource.data, 'description', 500);
        allow delete: if isGuardian(familyId);
      }

      match /taskInstances/{instanceId} {
        // Responsável vê tudo; criança só as próprias (query precisa filtrar
        // por `memberUid == uid`).
        allow read: if isGuardian(familyId)
          || (isChildOf(familyId) && ownsChildDoc(resource.data));

        allow create: if isGuardian(familyId)
          && request.resource.data.status in
             ['pending', 'awaitingApproval', 'approved', 'rejected']
          && request.resource.data.taskId is string
          && request.resource.data.memberId is string;

        // `pointsAwarded` (crédito) e `memberUid` são das Functions — o
        // cliente nunca os altera. Responsável muda status/revisão livremente
        // (só não pula para `approved` sem passar por `awaitingApproval`
        // quando a tarefa exige aprovação). A criança só marca a PRÓPRIA
        // tarefa: `pending -> awaitingApproval` (ou `-> approved` quando não
        // exige aprovação), mexendo apenas em
        // status/completedAt/rejectionReason/updatedAt.
        allow update: if
          request.resource.data.taskId == resource.data.taskId
          && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.get('pointsAwarded', null)
             == resource.data.get('pointsAwarded', null)
          && request.resource.data.get('memberUid', null)
             == resource.data.get('memberUid', null)
          && (
            (
              isGuardian(familyId)
              && request.resource.data.status in
                 ['pending', 'awaitingApproval', 'approved', 'rejected']
              && (
                request.resource.data.status != 'approved'
                || resource.data.status == 'awaitingApproval'
                || resource.data.requiresApproval == false
              )
            )
            || (
              isChildOf(familyId)
              && ownsChildDoc(resource.data)
              && resource.data.status == 'pending'
              && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'completedAt', 'rejectionReason', 'updatedAt'])
              && (
                request.resource.data.status == 'awaitingApproval'
                || (
                  request.resource.data.status == 'approved'
                  && resource.data.requiresApproval == false
                )
              )
            )
          );

        allow delete: if isGuardian(familyId);
      }

      match /rewards/{rewardId} {
        allow read: if isGuardian(familyId) || isChildOf(familyId);
        allow create, update: if isGuardian(familyId)
          && isNonEmptyString(request.resource.data.title, 80)
          && request.resource.data.cost is int
          && request.resource.data.cost > 0
          && request.resource.data.active is bool
          && optionalString(request.resource.data, 'description', 500);
        allow delete: if isGuardian(familyId);
      }

      // Resgates: criados só pela Cloud Function `redeemReward` (débito
      // transacional). O responsável lê e marca como entregue; a criança lê
      // os próprios.
      match /redemptions/{redemptionId} {
        allow read: if isGuardian(familyId)
          || (isChildOf(familyId) && ownsChildDoc(resource.data));
        allow create, delete: if false;
        allow update: if isGuardian(familyId)
          && request.resource.data.rewardId == resource.data.rewardId
          && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.cost == resource.data.cost
          && request.resource.data.status in ['requested', 'delivered', 'canceled'];
      }

      // Append-only: sem update/delete pelo cliente.
      match /ledger/{entryId} {
        allow read: if isGuardian(familyId)
          || (isChildOf(familyId) && ownsChildDoc(resource.data));
        // O cliente só cria ajuste manual. `earn` (aprovação) e `redeem`
        // (resgate) vêm das Cloud Functions (admin, ignora as rules).
        allow create: if isGuardian(familyId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.memberId is string
          && request.resource.data.type == 'adjustment'
          && request.resource.data.sourceType == 'manual'
          && request.resource.data.points is int
          && request.resource.data.points != 0;
        allow update, delete: if false;
      }
    }

    // Qualquer outro caminho: negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
